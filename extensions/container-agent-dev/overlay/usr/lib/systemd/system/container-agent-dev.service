[Unit]
Description=Avocado Container Dev Mode device agent (development only)
Documentation=https://github.com/avocadolinux/avocado-os
After=network.target
Wants=network.target
# Stay inert until `avocado container dev up` delivers the bootstrap (bulk
# endpoint, read/control token, pinned CA) to the writable partition (design
# D5/5.2). No bootstrap means no session to join, so there is nothing to do.
ConditionPathExists=/var/lib/avocado/container-dev/bootstrap.json

[Service]
# StateDirectory replaces the former `ExecStartPre=/bin/mkdir -p`, which could
# not run under a read-only /var. Mode 0700 is NOT the default: systemd applies
# 0755 on every start, including to a directory that already exists, and this
# one holds bootstrap.json with the Bearer read/control token and the session
# CA. Without this line a `systemctl start` silently widens a 0700 directory
# created by `avocado container dev up`.
StateDirectory=avocado/container-dev
StateDirectoryMode=0700
ExecStart=/usr/bin/avocado-container-agent-dev
Environment=RUST_LOG=info
# Pin the engine rather than leaving the DOCKER ONLY decision below to a comment.
# The agent only warns on a podman value and then execs it anyway (deliberately -
# the restriction is this unit's, not the binary's, so a debugging run outside the
# unit still works), which means an unset variable here let a DefaultEnvironment=
# in system.conf select podman. That failure is the worst shape available: podman
# dies at store init under this sandbox, on_sync's error is only logged, the unit
# stays active (running), and every Sync silently no-ops while the device keeps
# reporting healthy. A unit-level Environment= beats DefaultEnvironment=, so this
# closes that path.
Environment=AVOCADO_CONTAINER_DEV_ENGINE=docker

# DOCKER ONLY. This unit deliberately does not support the podman engine.
#
# The agent runs as root: it listens on a loopback socket, dials outbound TLS,
# parses untrusted WS/HTTP frames, and execs the container engine as its own
# child. Confining that meant choosing, because the two goals are mutually
# exclusive. systemd.exec(5) is explicit that ProtectSystem is undone by a
# privileged process unless paired with CapabilityBoundingSet=~CAP_SYS_ADMIN -
# root can otherwise remount its own read-only binds read-write - and rootful
# podman needs exactly CAP_SYS_ADMIN, plus namespaces, cgroup writes and kernel
# knobs, all in-process. Keeping podman working meant the sandbox was decorative;
# a real sandbox means podman cannot run under this unit.
#
# We chose the sandbox. Docker is unaffected: its daemon is a separate unit
# holding the privilege, reached over an AF_UNIX socket, and a read-only mount
# does not block connect() to a socket. Restoring podman properly is tracked as
# a follow-up - it needs the engine out of this process, not a weaker unit.
CapabilityBoundingSet=
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
RestrictNamespaces=true
# PrivateDevices, ProtectKernelTunables and ProtectControlGroups are the three
# directives systemd.exec(5) names as closing ProtectSystem=strict's /dev, /proc
# and /sys carve-outs; strict alone leaves all three writable. /dev is the one
# that matters most here: block devices are root:disk 0660 and this agent runs as
# root, so the owner bits alone allow opening /dev/mmcblk0 O_RDWR and overwriting
# the "read-only" rootfs. An empty CapabilityBoundingSet does not stop it and
# SystemCallFilter has nothing to deny - the open needs no capability and no
# privileged syscall. Without this line the untrusted WS/HTTP frame path can
# reach the exact hole the block above claims to have closed.
PrivateDevices=yes
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# The agent writes active-image.json into StateDirectory, so this keeps that file
# off world-readable. It does NOT govern bootstrap.json: the host writes that one
# (see main.rs) and the agent only reads it, so the Bearer read/control token's
# mode is set by the delivery path, not here. StateDirectoryMode=0700 above is
# what keeps the token unreadable, and even that first applies at `systemctl
# start` - after ConditionPathExists has already proven bootstrap.json exists.
# Writing it 0600 belongs on the CLI side that delivers it.
UMask=0077

# StateDirectory is the only PERSISTENT writable path under ProtectSystem=strict,
# which is all the agent needs: bootstrap.json and active-image.json both live
# there. PrivateTmp above also grants a private /tmp and /var/tmp, discarded when
# the unit stops - so a new write path needs its own directive only if it must
# survive a restart.
#
# No AF_NETLINK. It was only ever required by netavark configuring a podman
# container's netns; the docker CLI just talks to its daemon over AF_UNIX, and
# the agent's own traffic is AF_INET/AF_INET6.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Raise the fd ceiling rather than only absorbing EMFILE in the proxy's accept
# loop; the default is the reason that error path exists at all.
LimitNOFILE=65536

Restart=always
RestartSec=5
SyslogIdentifier=avocado-container-agent-dev

[Install]
WantedBy=multi-user.target
