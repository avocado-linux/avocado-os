# Arguments for the Avocado Glances telemetry service.
# Edit, then: systemctl restart avocado-glances
#
#   -q               headless (no curses UI) — required under systemd
#   --export mqtt    exporter(s), comma-separated: mqtt,statsd,prometheus,json,…
#   -t 60            transmit / refresh interval in SECONDS   <-- interval knob
#   --config ...     appended by the unit; do not repeat here
#
# The set of metrics collected is controlled in glances.conf, not here.
#
# Default (Milestone 2): export via RESTful to the local bridge, which forwards
# to avocado-conn's single authenticated uplink. To instead push straight to a
# broker (Milestone 1 / local testing), use: -q --export mqtt -t 60
GLANCES_ARGS="-q --export restful -t 60"
