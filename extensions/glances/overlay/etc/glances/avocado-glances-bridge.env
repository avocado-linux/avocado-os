# Avocado Glances -> avocado-conn bridge configuration.
# Restart after editing: systemctl restart avocado-glances-bridge

# Where the bridge receives glances RESTful POSTs. Must match the [restful]
# section in glances.conf.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=6789

# avocado-conn publish-ingest socket (event/{id} uplink).
CONN_PUBLISH_SOCKET=/run/avocado-conn/publish.sock

# event/{id} message "type" field.
MSG_TYPE=metrics

# Optional extra cardinality guard: forward only these top-level glances plugins.
# Leave unset to forward everything glances.conf collects.
# INCLUDE_PLUGINS=cpu,mem,memswap,load,fs,network,sensors,uptime,system,quicklook
