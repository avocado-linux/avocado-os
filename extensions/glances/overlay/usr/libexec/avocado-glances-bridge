#!/usr/bin/env python3
"""avocado-glances-bridge — glances RESTful export -> avocado-conn publish socket.

Milestone 2 transport for device telemetry. glances runs with `--export restful`
and POSTs the full (glances.conf-selected) stats JSON to this bridge every refresh
(`-t` interval). The bridge wraps each POST as an `event/{id}` message and writes
newline-delimited JSON to avocado-conn's publish-ingest socket, so telemetry rides
the single authenticated MQTT session (per-device auth, event/{id} topic scheme,
cardinality control) instead of opening a second cloud connection.

Pure stdlib (http.server + socket) — no third-party deps. Configured via env
(see /etc/glances/avocado-glances-bridge.env):
  BRIDGE_HOST / BRIDGE_PORT   where glances POSTs (must match glances.conf [restful])
  CONN_PUBLISH_SOCKET         avocado-conn publish socket
  MSG_TYPE                    event type field (default "metrics")
  INCLUDE_PLUGINS             optional comma list; if set, only these top-level
                              glances keys are forwarded (extra cardinality guard)
"""
import json
import os
import socket
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

HOST = os.environ.get("BRIDGE_HOST", "127.0.0.1")
PORT = int(os.environ.get("BRIDGE_PORT", "6789"))
SOCK = os.environ.get("CONN_PUBLISH_SOCKET", "/run/avocado-conn/publish.sock")
MSG_TYPE = os.environ.get("MSG_TYPE", "metrics")
INCLUDE = [p.strip() for p in os.environ.get("INCLUDE_PLUGINS", "").split(",") if p.strip()]


def forward(payload):
    """Write one newline-JSON message to avocado-conn's publish socket, read ack."""
    line = (json.dumps(payload, separators=(",", ":")) + "\n").encode()
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        s.connect(SOCK)
        s.sendall(line)
        s.recv(256)  # ack: {"ok":true}; contents ignored (best-effort)
    finally:
        s.close()


class Handler(BaseHTTPRequestHandler):
    def do_POST(self):
        n = int(self.headers.get("Content-Length", 0) or 0)
        raw = self.rfile.read(n) if n else b"{}"
        try:
            stats = json.loads(raw)
        except json.JSONDecodeError:
            self.send_response(400)
            self.end_headers()
            return
        if INCLUDE and isinstance(stats, dict):
            stats = {k: v for k, v in stats.items() if k in INCLUDE}
        msg = {"type": MSG_TYPE, "source": "glances", "stats": stats}
        try:
            forward(msg)
            self.send_response(204)
        except OSError as e:
            sys.stderr.write(f"avocado-glances-bridge: forward failed: {e}\n")
            self.send_response(502)
        self.end_headers()

    def log_message(self, *_args):
        pass  # quiet; systemd journal already has our stderr


def main():
    sys.stderr.write(
        f"avocado-glances-bridge: listening {HOST}:{PORT} -> {SOCK} (type={MSG_TYPE})\n"
    )
    ThreadingHTTPServer((HOST, PORT), Handler).serve_forever()


if __name__ == "__main__":
    main()
