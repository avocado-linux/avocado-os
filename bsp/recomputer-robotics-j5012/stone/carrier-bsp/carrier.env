# Carrier-BSP env consumed by stone-provision-tegraflash.sh.
#
# Seeed reComputer Robotics J5012: J501 carrier + Jetson AGX Orin 64GB
# module (P3701-0005). The values below come from Seeed's
# recomputer-robo-agx-orin-j501x.conf (Seeed-Studio/Linux_for_Tegra,
# SKU 0005 branch, commit f9a68317fbe3d276efc25b14b8b72339a1cc5d5c),
# the conf Seeed's flash.sh selects for this product, except the MB2 file
# (authored in this extension) and the two CHECK pins (also present in the
# stock devkit flashvars). Flash profile is the devkit one
# (`jetson-agx-orin-devkit`), whose machine config already bakes
# CHECK_BOARDSKU=0005.
#
# Generic knob shape:
#   CARRIER_FV_<NAME>=value   -> patches <NAME> in flashvars
#   CARRIER_ENV_<NAME>=value  -> patches <NAME> in .env.initrd-flash
# See meta-avocado-nvidia/docs/adding-a-jetson-carrier.md.

CARRIER_LABEL="Seeed reComputer Robotics J5012 (J501 carrier + Jetson AGX Orin 64GB, P3701-0005)"

# Kernel DTB - conf line, inside update_flash_args_p3737_0000_p3701_0000
# (board_sku 0005 branch):
#   DTB_FILE=tegra234-j501x-0000+p3701-0005-recomputer-robo.dtb;
#
# No CARRIER_FV_TBCDTB_FILE on purpose. The stock flashvars carries
# TBCDTB_FILE="@DTBFILE@" and tegra234-flash-helper.sh:609-611 resolves
# that placeholder to its dtb argument ($2, the DTBFILE that
# initrd-flash.sh passes at initrd-flash.sh:332). Setting DTBFILE here
# therefore covers it; a literal would drop the placeholder mechanism.
CARRIER_ENV_DTBFILE="tegra234-j501x-0000+p3701-0005-recomputer-robo.dtb"

# Pinmux - conf line: PINMUX_CONFIG="recomputer-robotics-agx-orin-j501x-pinmux.dtsi";
CARRIER_FV_PINMUX_CONFIG="recomputer-robotics-agx-orin-j501x-pinmux.dtsi"

# Pad voltage - conf line:
#   PMC_CONFIG="recomputer-robotics-agx-orin-j501x-padvoltage-default.dtsi";
CARRIER_FV_PMC_CONFIG="recomputer-robotics-agx-orin-j501x-padvoltage-default.dtsi"

# UPHY lane and 10G configuration - conf line:
#   ODMDATA="gbe-uphy-config-22,nvhs-uphy-config-0,hsio-uphy-config-16,gbe0-enable-10g,hsstp-lane-map-3";
# The devkit value is hsio-uphy-config-0 and Seeed's conf sets
# hsio-uphy-config-16 for this product; the reason is not documented.
# On this feed the key is ODMDATA (the 2026 feed renamed it
# TEGRA_FLASHVAR_ODMDATA).
CARRIER_ENV_ODMDATA="gbe-uphy-config-22,nvhs-uphy-config-0,hsio-uphy-config-16,gbe0-enable-10g,hsstp-lane-map-3"

# MB2 BCT misc DTS - the stock flashvars value is
# tegra234-mb2-bct-misc-p3701-0000.dts. The conf has no line for it; this
# file is authored in this extension from the stock NVIDIA misc DTS plus
# the single carrier-EEPROM change Seeed makes (see its header). The
# flashvars key is MB2BCT_CFG, not MB2_BCT (the shell variable in
# p3701.conf.common is renamed on export); patching MB2_BCT would be a
# silent no-op.
CARRIER_FV_MB2BCT_CFG="tegra234-mb2-bct-misc-p3701-0000-seeed.dts"

# EEPROM comparison - conf line: the update_flash_args_p3737_0000_p3701_0000
# board_sku 0005 branch accepts only 0005 (0004 selects the 32GB DTB and
# is not this product). The devkit machine already bakes
# CHECK_BOARDSKU=0005, so these two lines are redundant pins; they stay so
# a 32GB SKU 0004 module fails signing even if the machine default moves.
CARRIER_FV_CHECK_BOARDID="3701"
CARRIER_FV_CHECK_BOARDSKU="0005"

# Deliberately not overridden:
#   - SCR_CONFIG: the stock config is used unchanged.
#   - PMIC / BPMP / SDRAM: MIC-733-AO6A1 boots the same SKU-0005 module on
#     the same target with none of these overridden.
